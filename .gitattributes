* text=auto
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.exe binary
*.vsix binary
*.zip binary
# Preserve upstream files and their recorded hashes exactly.
vendor/** -text -whitespace
# Keep build artifacts out of new source archives; preserve tracked historical files.
output/** export-ignore
