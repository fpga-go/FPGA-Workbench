        {
          "begin": "^\\s*([a-zA-Z_][a-zA-Z0-9_$]*)\\s*(#)(?=\\s*\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.module.verilog"
            }
          },
          "end": ";",
          "endCaptures": {
            "0": {
              "name": "punctuation.terminator.expression.verilog"
