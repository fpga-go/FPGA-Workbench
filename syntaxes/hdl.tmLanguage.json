  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "(^[ \\t]+)?(?=//)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.verilog"
            }
          },
          "end": "(?!\\G)",
          "patterns": [
            {
              "begin": "//",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.verilog"
                }
              },
              "end": "\\n",
              "name": "comment.line.double-slash.verilog"
            }
          ]
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.c-style.verilog"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "`(?!(?:celldefine|endcelldefine|default_nettype|define|undef|ifdef|ifndef|elsif|else|endif|include|resetall|timescale|unconnected_drive|nounconnected_drive|line|pragma|begin_keywords|end_keywords|undefineall)\\b)[a-zA-Z_][a-zA-Z0-9_$]*",
          "name": "variable.other.constant.verilog"
        },
        {
          "match": "(?<![a-zA-Z0-9_$])(?:[1-9][0-9_]*)?'(?:[sS]?[bB][ \\t]*[01xXzZ?][01_xXzZ?]*|[sS]?[oO][ \\t]*[0-7xXzZ?][0-7_xXzZ?]*|[sS]?[dD][ \\t]*[0-9xXzZ?][0-9_xXzZ?]*|[sS]?[hH][ \\t]*[0-9a-fA-FxXzZ?][0-9a-fA-F_xXzZ?]*)(?![a-zA-Z0-9_$])",
          "name": "constant.numeric.sized_integer.verilog"
        },
        {
          "captures": {
            "1": {
              "name": "constant.numeric.integer.verilog"
            },
            "2": {
              "name": "punctuation.separator.range.verilog"
            },
            "3": {
              "name": "constant.numeric.integer.verilog"
            }
          },
          "match": "\\b(\\d+)(:)(\\d+)\\b",
          "name": "meta.block.numeric.range.verilog"
        },
        {
          "match": "\\b(?:[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*)\\b",
          "name": "constant.numeric.real.verilog"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.integer.verilog"
        },
        {
          "match": "#\\d+",
          "name": "constant.numeric.delay.verilog"
        },
        {
          "match": "\\b[01xXzZ]+\\b",
          "name": "constant.numeric.logic.verilog"
        }
      ]
    },
    "instantiation_patterns": {
