{
  "name": "fpga-workbench",
  "displayName": "FPGA Workbench · 工程导航",
  "description": "任意目录打开文件夹，选中工程文件，剩下的交给我吧。",
  "version": "0.2.34",
  "publisher": "fpga-go",
  "icon": "media/fpga-go-marketplace.png",
  "galleryBanner": {
    "color": "#082B50",
    "theme": "dark"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "FPGA",
    "Vivado",
    "Lattice",
    "Verilog",
    "SystemVerilog",
    "XPR",
    "LPF",
    "LDF"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "fpgaWorkbench.enableLint",
        "title": "启用语法检查",
        "category": "FPGA"
      },
      {
        "command": "fpgaWorkbench.disableLint",
        "title": "关闭语法检查",
        "category": "FPGA"
      },
      {
        "command": "fpgaWorkbench.configureLint",
        "title": "语法检查开关与工具",
        "category": "FPGA",
        "icon": "$(gear)"
      },
      {
        "command": "fpgaWorkbench.runLint",
        "title": "检查当前文件或工程语法",
        "category": "FPGA",
        "icon": "$(play)"
      },
      {
        "command": "fpgaWorkbench.showLintOutput",
        "title": "查看语法检查输出",
        "category": "FPGA",
        "icon": "$(output)"
      },
      {
        "command": "fpgaWorkbench.selectLintTool",
        "title": "选择语法检查工具",
        "category": "FPGA",
        "icon": "$(tools)"
      },
      {
        "command": "fpgaWorkbench.selectManualLintTool",
        "title": "手动选择语法检查工具路径",
        "category": "FPGA",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fpgaWorkbench.selectProjectType",
        "title": "选择工程类型：Vivado (Xilinx) / Diamond (Lattice)",
        "category": "FPGA",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "fpgaWorkbench.selectProject",
        "title": "选择 FPGA 工程 (.xpr / .lpf / .ldf)",
        "category": "FPGA",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fpgaWorkbench.switchProject",
        "title": "切换工程 (.xpr / .lpf / .ldf)",
        "category": "FPGA",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fpgaWorkbench.closeProject",
        "title": "关闭工程",
        "category": "FPGA",
        "icon": "$(close)"
      },
      {
        "command": "fpgaWorkbench.refresh",
        "title": "刷新工程索引",
        "category": "FPGA",
        "icon": "$(refresh)"
      },
      {
        "command": "fpgaWorkbench.selectFileset",
        "title": "选择设计文件集",
        "category": "FPGA",
        "icon": "$(list-selection)"
      },
      {
        "command": "fpgaWorkbench.selectTop",
        "title": "选择顶层模块",
        "category": "FPGA",
        "icon": "$(circuit-board)"
      },
      {
        "command": "fpgaWorkbench.exportFilelist",
        "title": "导出 Filelist",
        "category": "FPGA",
        "icon": "$(export)"
      },
      {
        "command": "fpgaWorkbench.openFilelistSkill",
        "title": "打开 Filelist Skill",
        "category": "FPGA",
        "icon": "$(book)"
      },
      {
        "command": "fpgaWorkbench.projectInfo",
        "title": "查看工程路径与索引状态",
        "category": "FPGA",
        "icon": "$(info)"
      },
      {
        "command": "fpgaWorkbench.peekDefinition",
        "title": "速览本地定义与上层连接（当前工程）",
        "category": "FPGA"
      },
      {
        "command": "fpgaWorkbench.gotoDefinition",
        "title": "转到定义与信号引用（当前工程）",
        "category": "FPGA"
      },
      {
        "command": "fpgaWorkbench.parentConnections",
        "title": "查找引用（当前工程）",
        "category": "FPGA"
      },
      {
        "command": "fpgaWorkbench.selectColorScheme",
        "title": "选择语法配色方案",
        "category": "FPGA Workbench"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fpgaWorkbench",
          "title": "FPGA Workbench",
          "icon": "media/fpga.svg"
        }
      ]
    },
    "views": {
      "fpgaWorkbench": [
        {
          "id": "fpgaWorkbench.files",
          "name": "工程文件"
        },
        {
          "id": "fpgaWorkbench.hierarchy",
          "name": "模块层级"
        },
        {
          "id": "fpgaWorkbench.lint",
          "name": "Lint"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fpgaWorkbench.files",
        "contents": "任意目录打开文件夹，选中工程文件，剩下的交给我吧。\n已支持：Vivado (Xilinx) .xpr · Diamond (Lattice) .lpf / .ldf · Filelist\n[工程类型：Vivado (Xilinx)](command:fpgaWorkbench.selectProjectType)\n[选择工程 (.xpr / All Files)](command:fpgaWorkbench.selectProject)",
        "when": "!fpgaWorkbench.hasProject && fpgaWorkbench.projectType != 'lattice' && fpgaWorkbench.projectType != 'filelist'"
      },
      {
        "view": "fpgaWorkbench.files",
        "contents": "任意目录打开文件夹，选中工程文件，剩下的交给我吧。\n已支持：Vivado (Xilinx) .xpr · Diamond (Lattice) .lpf / .ldf · Filelist\n[工程类型：Diamond (Lattice)](command:fpgaWorkbench.selectProjectType)\n[选择工程 (.lpf / .ldf / All Files)](command:fpgaWorkbench.selectProject)",
        "when": "!fpgaWorkbench.hasProject && fpgaWorkbench.projectType == 'lattice'"
      },
      {
        "view": "fpgaWorkbench.files",
        "contents": "任意目录打开文件夹，选中工程文件，剩下的交给我吧。\n已支持：Vivado (Xilinx) .xpr · Diamond (Lattice) .lpf / .ldf · Filelist\n[工程类型：Filelist / All Files](command:fpgaWorkbench.selectProjectType)\n[选择工程 (All Files → Filelist)](command:fpgaWorkbench.selectProject)",
        "when": "!fpgaWorkbench.hasProject && fpgaWorkbench.projectType == 'filelist'"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fpgaWorkbench.runLint",
          "when": "view == fpgaWorkbench.lint",
          "group": "navigation@1"
        },
        {
          "command": "fpgaWorkbench.selectLintTool",
          "when": "view == fpgaWorkbench.lint",
          "group": "navigation@2"
        },
        {
          "command": "fpgaWorkbench.showLintOutput",
          "when": "view == fpgaWorkbench.lint",
          "group": "navigation@3"
        },
        {
          "command": "fpgaWorkbench.configureLint",
          "when": "view == fpgaWorkbench.lint"
        },
        {
          "command": "fpgaWorkbench.selectManualLintTool",
          "when": "view == fpgaWorkbench.lint"
        },
        {
          "command": "fpgaWorkbench.selectProject",
          "when": "view == fpgaWorkbench.files && !fpgaWorkbench.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "fpgaWorkbench.switchProject",
          "when": "view == fpgaWorkbench.files && fpgaWorkbench.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "fpgaWorkbench.closeProject",
          "when": "view == fpgaWorkbench.files && fpgaWorkbench.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "fpgaWorkbench.refresh",
          "when": "view == fpgaWorkbench.files && fpgaWorkbench.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "fpgaWorkbench.selectProjectType",
          "when": "view == fpgaWorkbench.files"
        },
        {
          "command": "fpgaWorkbench.selectFileset",
          "when": "view == fpgaWorkbench.files && fpgaWorkbench.loaded"
        },
        {
          "command": "fpgaWorkbench.exportFilelist",
          "when": "view == fpgaWorkbench.files && fpgaWorkbench.loaded"
        },
        {
          "command": "fpgaWorkbench.projectInfo",
          "when": "view == fpgaWorkbench.files && fpgaWorkbench.loaded"
        },
        {
          "command": "fpgaWorkbench.openFilelistSkill",
          "when": "view == fpgaWorkbench.files"
        },
        {
          "command": "fpgaWorkbench.selectTop",
          "when": "view == fpgaWorkbench.hierarchy && fpgaWorkbench.loaded",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fpgaWorkbench.switchProject",
          "when": "view == fpgaWorkbench.files && viewItem == fpgaWorkbench.project",
          "group": "project@1"
        },
        {
          "command": "fpgaWorkbench.closeProject",
          "when": "view == fpgaWorkbench.files && viewItem == fpgaWorkbench.project",
          "group": "project@2"
        }
      ],
      "editor/context": [
        {
          "command": "fpgaWorkbench.configureLint",
          "when": "resourceExtname =~ /\\.(v|sv|vh|svh|vhd|vhdl)$/",
          "group": "navigation@14"
        },
        {
          "command": "fpgaWorkbench.runLint",
          "when": "resourceExtname =~ /\\.(v|sv|vh|svh|vhd|vhdl)$/",
          "group": "navigation@13"
        },
        {
          "command": "fpgaWorkbench.peekDefinition",
          "when": "fpgaWorkbench.loaded && resourceExtname =~ /\\.(v|sv|vh|svh)$/",
          "group": "navigation@10"
        },
        {
          "command": "fpgaWorkbench.gotoDefinition",
          "when": "fpgaWorkbench.loaded && resourceExtname =~ /\\.(v|sv|vh|svh)$/",
          "group": "navigation@11"
        },
        {
          "command": "fpgaWorkbench.parentConnections",
          "when": "fpgaWorkbench.loaded && resourceExtname =~ /\\.(v|sv|vh|svh)$/",
          "group": "navigation@12"
        }
      ]
    },
    "languages": [
      {
        "id": "verilog",
        "extensions": [
          ".v",
          ".vh"
        ],
        "aliases": [
          "Verilog"
        ],
        "configuration": "language-configuration.json"
      },
      {
        "id": "systemverilog",
        "extensions": [
          ".sv",
          ".svh"
        ],
        "aliases": [
          "SystemVerilog"
        ],
        "configuration": "language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "syntaxes/hdl.tmLanguage.json",
        "unbalancedBracketScopes": [
          "meta.identifier",
          "meta.instance.name",
          "entity.name.type",
          "entity.name.function",
          "entity.name.section",
          "entity.name.label",
          "support.function",
          "support.type.scope",
          "storage.type.user-defined",
          "storage.type.userdefined",
          "variable.other.constant"
        ]
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "syntaxes/systemverilog.tmLanguage.json",
        "unbalancedBracketScopes": [
          "meta.identifier",
          "meta.instance.name",
          "entity.name.type",
          "entity.name.function",
          "entity.name.section",
          "entity.name.label",
          "support.function",
          "support.type.scope",
          "storage.type.user-defined",
          "storage.type.userdefined",
          "variable.other.constant"
        ]
      }
    ],
    "configuration": {
      "title": "FPGA Workbench",
      "properties": {
        "fpgaWorkbench.projectType": {
          "type": "string",
          "enum": [
            "vivado",
            "lattice",
            "filelist"
          ],
          "enumDescriptions": [
            "Vivado (Xilinx) 工程 (.xpr)",
            "Diamond (Lattice) 工程 (.lpf / .ldf)",
            "Filelist / All Files（未知类型按 Filelist 解析）"
          ],
          "default": "vivado",
          "description": "工程类型选择开关：Vivado (Xilinx) 工程、Diamond (Lattice) 工程或 Filelist。"
        },
        "fpgaWorkbench.highlighting.mode": {
          "type": "string",
          "enum": [
            "theme",
            "fixed",
            "custom"
          ],
          "enumDescriptions": [
            "跟随当前主题。",
            "使用此前版本的固定深浅配色。",
            "使用自定义颜色，未填写的类别沿用固定配色。"
          ],
          "scope": "window",
          "default": "theme",
          "description": "HDL 语法配色。修改后立即生效。"
        },
        "fpgaWorkbench.lint.ignoreTimescaleWarnings": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "忽略 timescale 警告。语法错误仍会报告。"
        },
        "fpgaWorkbench.lint.verbose": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "输出完整编译命令和参数。"
        },
        "fpgaWorkbench.lint.runOnSave": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "保存 HDL 文件后自动检查。"
        },
        "fpgaWorkbench.lint.timeoutMs": {
          "type": "integer",
          "scope": "resource",
          "minimum": 1000,
          "maximum": 600000,
          "default": 30000,
          "description": "每个编译步骤的超时毫秒数。"
        },
        "fpgaWorkbench.backend": {
          "type": "string",
          "enum": [
            "auto",
            "builtin",
            "slang"
          ],
          "default": "auto",
          "description": "auto 优先使用自带/指定的 slang-server；builtin 使用有限结构索引。修改后刷新工程。"
        },
        "fpgaWorkbench.slangPath": {
          "type": "string",
          "default": "",
          "description": "可选：slang-server 可执行文件的绝对路径。"
        },
        "fpgaWorkbench.sourceEncoding": {
          "type": "string",
          "enum": [
            "auto",
            "utf-8",
            "gb18030"
          ],
          "default": "auto",
          "description": "关闭文件的读取编码；auto 先检查 UTF-8，再按 GB18030 解码。源文件不会被改写。"
        },
        "fpgaWorkbench.includeSimulation": {
          "type": "boolean",
          "default": false,
          "description": "将仿真文件集加入索引。"
        },
        "fpgaWorkbench.extraIncludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "额外 include 目录；相对路径以 XPR 所在目录为基准。"
        },
        "fpgaWorkbench.extraDefines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "额外宏定义，例如 SIMULATION 或 WIDTH=32。"
        },
        "fpgaWorkbench.watchFiles": {
          "type": "boolean",
          "default": true,
          "description": "监听工程文件在编辑器外的更改。"
        },
        "fpgaWorkbench.highlighting.lightColors": {
          "type": "object",
          "scope": "window",
          "default": {},
          "additionalProperties": false,
          "description": "浅色主题的自定义语法颜色。仅 custom 模式生效。",
          "properties": {
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "普通文字，使用 #RRGGBB。"
            },
            "comment": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "注释，使用 #RRGGBB。"
            },
            "string": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "字符串，使用 #RRGGBB。"
            },
            "number": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "数字，使用 #RRGGBB。"
            },
            "declaration": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "模块声明，使用 #RRGGBB。"
            },
            "type": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "数据类型，使用 #RRGGBB。"
            },
            "assignment": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "赋值，使用 #RRGGBB。"
            },
            "keyword": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "流程关键字，使用 #RRGGBB。"
            },
            "module": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "模块类型，使用 #RRGGBB。"
            },
            "function": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "函数，使用 #RRGGBB。"
            },
            "macro": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "宏，使用 #RRGGBB。"
            }
          }
        },
        "fpgaWorkbench.highlighting.darkColors": {
          "type": "object",
          "scope": "window",
          "default": {},
          "additionalProperties": false,
          "description": "深色主题的自定义语法颜色。仅 custom 模式生效。",
          "properties": {
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "普通文字，使用 #RRGGBB。"
            },
            "comment": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "注释，使用 #RRGGBB。"
            },
            "string": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "字符串，使用 #RRGGBB。"
            },
            "number": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "数字，使用 #RRGGBB。"
            },
            "declaration": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "模块声明，使用 #RRGGBB。"
            },
            "type": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "数据类型，使用 #RRGGBB。"
            },
            "assignment": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "赋值，使用 #RRGGBB。"
            },
            "keyword": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "流程关键字，使用 #RRGGBB。"
            },
            "module": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "模块类型，使用 #RRGGBB。"
            },
            "function": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "函数，使用 #RRGGBB。"
            },
            "macro": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "宏，使用 #RRGGBB。"
            }
          }
        },
        "fpgaWorkbench.navigation.candidateList": {
          "type": "string",
          "scope": "window",
          "enum": [
            "summary",
            "native"
          ],
          "enumDescriptions": [
            "显示只读候选页，保留 Ctrl+左键入口。",
            "使用 VS Code 原生候选列表。"
          ],
          "default": "native",
          "description": "导航候选显示方式。修改后下次查询生效。"
        }
      }
    },
    "snippets": [
      {
        "language": "verilog",
        "path": "./snippets/hdl-sections.json"
      },
      {
        "language": "systemverilog",
        "path": "./snippets/hdl-sections.json"
      }
    ]
  },
  "author": {
    "name": "fpga-go",
    "email": "fpga_go@163.com"
  },
  "repository": {
    "url": "https://github.com/fpga-go/FPGA-Workbench.git",
    "type": "git"
  },
  "homepage": "https://github.com/fpga-go/FPGA-Workbench/tree/develop#readme",
  "bugs": {
    "url": "https://github.com/fpga-go/FPGA-Workbench/issues"
  }
}
